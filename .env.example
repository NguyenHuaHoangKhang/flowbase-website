# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://flowbase:password@localhost:5432/flowbase?schema=public"

# --- Website --------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=hello@flowbase.studio
# Nơi nhận request từ form Contact (Slack incoming webhook, n8n, Zapier...).
# Bỏ trống thì form sẽ nói rõ với người dùng là chưa có kênh nhận.
CONTACT_WEBHOOK_URL=

# --- Auth -----------------------------------------------------------------
# TODO: bắt buộc đặt trước khi deploy production
SESSION_SECRET=

# --- Integrations ---------------------------------------------------------
# Cột secretRef trong bảng integrations chỉ lưu TÊN của các biến dưới đây,
# không lưu giá trị. Server đọc process.env[secretRef] khi cần gọi API.
SLACK_BOT_TOKEN=
GOOGLE_SA_KEY=
ZALO_OA_TOKEN=
GITHUB_TOKEN=
VERCEL_TOKEN=
RESEND_API_KEY=
